# ─── Shopify ─────────────────────────────────────────────────────────────────
# From Partner Dashboard → App → Client secrets
SHOPIFY_API_KEY=your-app-client-id
SHOPIFY_API_SECRET=your-app-client-secret

# Must match the scopes line in shopify.app.toml EXACTLY, comma-separated.
# Current required set for Reeve AI (read + write + charts):
SCOPES=read_products,write_products,read_inventory,write_inventory,read_orders,read_customers,read_discounts,read_price_rules,read_reports

# Your Fly.io public URL (after first deploy), e.g. https://reeve-ai.fly.dev
SHOPIFY_APP_URL=https://your-app.fly.dev

# If the merchant uses a custom domain for their Shopify store, set it here.
# SHOP_CUSTOM_DOMAIN=shop.your-brand.com

# ─── AI ───────────────────────────────────────────────────────────────────────
# NVIDIA NIM LLM key (download from https://build.nvidia.com).
# The app works without it (demo-mode regex routing), but you get
# much smarter conversations with a live model.
NVIDIA_API_KEY=nvapi-
# NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ─── Database ─────────────────────────────────────────────────────────────────
# Fly.io: mount a volume at /data, then set:
#   DATABASE_URL=file:/data/prod.sqlite
# Local dev: defaults to file:dev.sqlite (resolved relative to prisma/ dir).
DATABASE_URL=file:/data/prod.sqlite

# ─── Node ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000