// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ─── Reeve AI models ──────────────────────────────────────────────────────────

/// One message in a conversation between the merchant and the Reeve agent.
model ChatMessage {
  id           String   @id @default(cuid())
  shop         String
  role         String // user | assistant
  content      String
  /// The model's short reasoning shown in the collapsible "Thinking…" chip.
  /// Null for legacy rows (rendered without the chip) and for user messages.
  reasoning    String?
  /// Wall-clock ms the agent took (planning + tools). Null for legacy rows.
  elapsedMs    Int?
  /// JSON: [{name, args, result, summary, ok}] — the agent's tool calls, rendered as action cards.
  actionsJson  String?
  createdAt    DateTime @default(now())

  @@index([shop, createdAt])
}

/// Immutable audit-trail row. Every agent write appends one with before/after.
model Activity {
  id         String   @id @default(cuid())
  shop       String
  type       String // inventory_update | availability_update | price_update | agent_message | system
  severity   String   @default("info") // info | warning | critical | success
  source     String   @default("agent") // agent | user | system
  message    String
  beforeJson String?
  afterJson  String?
  createdAt  DateTime @default(now())

  @@index([shop, createdAt])
}
